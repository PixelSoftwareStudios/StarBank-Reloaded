{
  "identifier": "main",
  "description": "Local StarBank desktop editor window",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-confirm-window-close",
    "allow-complete-window-close",
    "allow-open-bank",
    "allow-dispatch-bank",
    "allow-export-bank-copy",
    "allow-can-export-bank",
    "allow-list-open-requests",
    "allow-dismiss-open-request",
    "allow-open-requested-bank",
    "allow-resign-active-bank",
    "allow-pick-external-bank-to-resign",
    "allow-check-external-bank-signature",
    "allow-export-external-signed-bank",
    "allow-discard-external-signing-source",
    "allow-can-reveal-bank",
    "allow-reveal-active-bank",
    "allow-confirm-bank-navigation",
    "allow-save-active-bank",
    "allow-save-bank-as",
    "allow-compare-bank-conflict",
    "allow-reopen-bank-conflict",
    "allow-list-active-backups",
    "allow-active-backup-status",
    "allow-restore-active-bank",
    "allow-review-active-backup",
    "allow-export-active-backup",
    "allow-read-backup-preferences",
    "allow-choose-backup-location",
    "allow-use-default-backup-location",
    "allow-set-backup-retention",
    "allow-review-backup-retention",
    "allow-create-batch-backup",
    "allow-cancel-batch-backup",
    "allow-review-batch-backup",
    "allow-refresh-inventory",
    "allow-inventory-backup-status",
    "allow-rebuild-map-index",
    "allow-select-inventory-folder",
    "allow-use-automatic-inventory",
    "allow-cancel-inventory",
    "allow-open-bank-id",
    "allow-read-settings",
    "allow-change-setting",
    "allow-recover-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
